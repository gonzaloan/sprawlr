                {
                  "Action": "s3:GetObject",
                  "Effect": "Allow",
                  "Resource": "arn:aws:s3:::reports-uploads/*"
                },
                {
                  "Action": [
                    "s3:PutObject",
                    "s3:PutObjectAcl"
                  ],
                  "Effect": "Allow",
                  "Resource": "arn:aws:s3:::reports-output/*"
                },
                {
                  "Action": "dynamodb:*",
                  "Effect": "Allow",
                  "Resource": "*"
                }
              ],
              "Version": "2012-10-17"
            },
            "PolicyName": "reports-worker-inline"
          }
        ],
        "RoleName": "reports-worker-role"
