    "PlatformEvents": {
      "DeletionPolicy": "Retain",
      "Properties": {
        "Name": "platform-events"
      },
      "Type": "AWS::Events::EventBus",
      "UpdateReplacePolicy": "Retain"
    },
    "ProdPrivateA": {
      "DeletionPolicy": "Retain",
      "Properties": {
        "AvailabilityZone": "us-east-1a",
        "CidrBlock": "10.0.10.0/24",
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
